# Copy outside the repository as production.runtime.env; do not commit secrets.
ENVIRONMENT=production
APP_COMPONENT=api
DATABASE_SCHEMA_MODE=migrate
DEPLOYMENT_ID=customer-stamp-a
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/b2b
REDIS_URL=rediss://REPLACE_REDIS_HOST:6380/0
RATE_LIMIT_BACKEND=redis
ASSET_STORAGE_ROOT=/srv/b2b/private-assets
ASSET_STORAGE_URI=s3://REPLACE_PRIVATE_ASSET_BUCKET/b2b-assets
BACKUP_TARGET=s3://REPLACE_OFFSITE_BACKUP_BUCKET/b2b-backups
BACKUP_WORKER_ROOT=/srv/b2b/backup-verification
RELEASE_ARTIFACT_ROOT=/srv/b2b/release-artifacts
BACKUP_SCHEDULE_ID=REPLACE_WITH_BACKUP_SCHEDULE_ID
RESTORE_DRILL_REFERENCE=REPLACE_WITH_RESTORE_DRILL_TICKET
PUBLIC_BASE_URL=https://REPLACE_DOMAIN
CORS_ALLOWED_ORIGINS=https://REPLACE_HQ_DOMAIN,https://REPLACE_DOMAIN
CONTENT_DOWNLOAD_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MASK_KEY=REPLACE_WITH_A_THIRD_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CONTENT_DOWNLOAD_SCANNER_COMMAND_JSON=["/usr/bin/clamscan","--no-summary","{file}"]
