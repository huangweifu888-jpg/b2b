# Copy outside source control as a production secret file; do not commit actual values.
ENVIRONMENT=production
APP_COMPONENT=api
DATABASE_SCHEMA_MODE=migrate
DEPLOYMENT_ID=prod-customer-stamp-a
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/b2b
REDIS_URL=redis://REPLACE_REDIS_HOST:6379/0
RATE_LIMIT_BACKEND=redis
# Private filesystem mount used by the scanner and download process; never web-served.
ASSET_STORAGE_ROOT=/srv/b2b/private-assets
# Object-storage source behind the private mount. Must be separate from backups.
ASSET_STORAGE_URI=s3://REPLACE_PRIVATE_ASSET_BUCKET/b2b-assets
BACKUP_TARGET=s3://REPLACE_OFFSITE_BACKUP_BUCKET/b2b-backups
BACKUP_WORKER_ROOT=/srv/b2b/backup-verification
RELEASE_ARTIFACT_ROOT=/srv/b2b/release-artifacts
# Stable managed-provider or operations-runner schedule identifier; not a credential.
BACKUP_SCHEDULE_ID=REPLACE_WITH_BACKUP_SCHEDULE_ID
# Ticket or evidence ID for a recent successful isolated restore drill; never put a backup URL here.
RESTORE_DRILL_REFERENCE=REPLACE_WITH_RESTORE_DRILL_TICKET
PUBLIC_BASE_URL=https://REPLACE_DOMAIN
CONTENT_DOWNLOAD_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# The identity provider must issue MFA evidence in mfa_completed, amr, or acr claims for these roles.
REQUIRE_MFA_FOR_PRIVILEGED_ROLES=true
MFA_PRIVILEGED_ROLES=admin,headquarters_administrator,technical_operations,security_owner
MASK_KEY=REPLACE_WITH_A_THIRD_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# ClamAV example; command must include {file}, execute without a shell, and exit 0 only when clean.
CONTENT_DOWNLOAD_SCANNER_COMMAND_JSON=["/usr/bin/clamscan","--no-summary","{file}"]
