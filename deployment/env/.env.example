# Do not add secrets to source control. Set actual values only in deployment environments.
ENVIRONMENT=dev
DATABASE_SCHEMA_MODE=bootstrap
APP_ROLE=customer
DEPLOYMENT_ID=shared-stamp-a
DATABASE_URL=sqlite:///./runtime/platform.sqlite3
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3003,http://localhost:3003
ASSET_STORAGE_ROOT=./runtime/files
BACKUP_TARGET=local-validation-only
BACKUP_WORKER_ROOT=./runtime/backups
RELEASE_ARTIFACT_ROOT=./runtime/release-artifacts
PUBLIC_BASE_URL=http://127.0.0.1:3004
PUBLIC_HTTPS_PORT=443
INTERNAL_API_PORT=8000
DOWNLOAD_URL_TTL_SECONDS=300
CONTENT_DOWNLOAD_ALLOWED_EXTENSIONS=.pdf,.csv,.docx,.xlsx,.pptx,.zip,.png,.jpg,.jpeg,.webp
CONTENT_DOWNLOAD_MAX_BYTES=52428800
CONTENT_DOWNLOAD_SCAN_TIMEOUT_SECONDS=120
CONTENT_DOWNLOAD_SCANNER_COMMAND_JSON=
TRUST_PROXY_HEADERS=false
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DOWNLOAD_TICKETS_PER_MINUTE=30
RATE_LIMIT_TEMPLATE_MUTATIONS_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory
CONTENT_DOWNLOAD_SECRET=
MASK_KEY=
