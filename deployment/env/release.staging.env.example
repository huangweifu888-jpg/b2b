# Copy outside source control as a staging secret file; do not commit actual values.
ENVIRONMENT=staging
APP_COMPONENT=api
DATABASE_SCHEMA_MODE=migrate
DEPLOYMENT_ID=staging-customer-stamp-a
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/b2b_staging
REDIS_URL=rediss://REPLACE_REDIS_HOST:6380/0
RATE_LIMIT_BACKEND=redis
ASSET_STORAGE_ROOT=/srv/b2b/private-assets
ASSET_STORAGE_URI=s3://REPLACE_PRIVATE_STAGING_ASSET_BUCKET/b2b-assets
BACKUP_TARGET=s3://REPLACE_OFFSITE_STAGING_BACKUP_BUCKET/b2b-backups
BACKUP_WORKER_ROOT=/srv/b2b/backup-verification
RELEASE_ARTIFACT_ROOT=/srv/b2b/release-artifacts
BACKUP_SCHEDULE_ID=REPLACE_WITH_STAGING_BACKUP_SCHEDULE_ID
RESTORE_DRILL_REFERENCE=REPLACE_WITH_STAGING_RESTORE_DRILL_TICKET
PUBLIC_BASE_URL=https://REPLACE_STAGING_DOMAIN
CONTENT_DOWNLOAD_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MASK_KEY=REPLACE_WITH_A_THIRD_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CONTENT_DOWNLOAD_SCANNER_COMMAND_JSON=["/usr/bin/clamscan","--no-summary","{file}"]
