  },
  "principles": [
    { "id": "one-source-tree", "rule": "Reusable implementation has one editable owner in 00-platform-source." },
    { "id": "shells-reference-stable-ids", "rule": "Shell compositions reference stable category or application IDs and modes; they never copy implementation." },
    { "id": "tenant-and-plan-are-data", "rule": "Agents, customers, and plans use scoped data, configuration, templates, and overlays; they never receive source forks." },
    { "id": "contracts-before-imports", "rule": "Modules integrate through shared contracts, APIs, or events and must not import another module implementation." },
    { "id": "no-empty-directory-catalog", "rule": "Catalog-only categories remain JSON records until a real migration creates owned files." },
    { "id": "tenant-context", "rule": "Tenant-aware work validates agent_path, tenant_id, client_id, and optional plan_id." },
    { "id": "download-owner", "rule": "Only legacy module 02-content exposes public plan downloads over HTTPS during the progressive migration." },
    { "id": "generated-delivery", "rule": "Outer 01-07 areas contain generated release artifacts, not editable application source." }
  ]
