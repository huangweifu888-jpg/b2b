    "TypeScript"
  ],
  "sourceOfTruth": "code-owned-page-factory",
  "scopes": [
    "hq",
    "agency_source",
    "client_source"
  ],
  "templates": [
    "reference",
    "dashboard",
    "list",
    "form",
    "detail",
    "editor",
    "workflow"
  ],
  "regionStrategies": [
    "explicit",
    "runtime-auto"
  ],
  "frameOwnershipModes": [
    "factory-shell",
    "existing-workspace"
  ],
  "templateRegions": {
    "reference": [
      "top",
      "body",
      "title-1",
      "footer"
    ],
    "dashboard": [
